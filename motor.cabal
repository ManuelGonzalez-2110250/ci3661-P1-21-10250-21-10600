cabal-version:      2.4
name:               aventura
version:            0.1.0.0
synopsis:           Motor de aventura conversacional en Haskell
author:             Tu Nombre

-- Configuración de la librería interna donde vive la lógica del motor
library
    exposed-modules:    Motor.Tipos
                        Motor.Mundo
                        Motor.Comandos
                        Motor.Nucleo                        
    hs-source-dirs:     src
    build-depends:      base >= 4.7 && < 5
                      , containers
                      , directory
                      , filepath
    default-language:   Haskell2010

-- Configuración del programa ejecutable (el juego en sí)
executable aventura
    main-is:            Main.hs
    hs-source-dirs:     app
    build-depends:      base >= 4.7 && < 5
                      , aventura
                      , containers
                      , directory
                      , filepath
    default-language:   Haskell2010